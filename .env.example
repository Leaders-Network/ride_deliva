# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/ride_deliva?schema=public"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_DB=ride_deliva
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Configuration
REDIS_URL="redis://localhost:6380"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6380

# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# JWT Configuration
JWT_SECRET=ride-deliva-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Encryption
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_KEY=ride-deliva-encryption-key-characters

# External Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# Push Notifications (FCM)
FCM_SERVER_KEY=your-fcm-server-key
FCM_SENDER_ID=your-fcm-sender-id

# Payment Gateway
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# File Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ride-deliva-storage

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# Session
SESSION_SECRET=your-session-secret-key
SESSION_MAX_AGE=86400000

# Monitoring
SENTRY_DSN=your-sentry-dsn

# Features Flags
ENABLE_RIDE_SHARING=true
ENABLE_DELIVERY=true
ENABLE_ANALYTICS=true
ENABLE_ADMIN_PANEL=true
