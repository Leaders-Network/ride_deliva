# Copy to backend/.env. Values match docker-compose.yml (Postgres on host port 5433, Redis on 6380).
# Use 127.0.0.1 rather than localhost: on Windows, localhost tries IPv6 (::1) first and
# Docker Desktop's ::1 forwarding stalls intermittently.

# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/ride_deliva?schema=public"
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433
POSTGRES_DB=ride_deliva
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Configuration
REDIS_URL="redis://127.0.0.1:6380"
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_HOST_PORT=6380

# Application Configuration
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# JWT Configuration
JWT_SECRET=ride-deliva-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# Encryption
BCRYPT_SALT_ROUNDS=12
ENCRYPTION_KEY=ride-deliva-encryption-key-characters

# External Services
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_PLACES_API_KEY=your-google-places-api-key

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-email-password

# Push Notifications (FCM)
FCM_SERVER_KEY=your-fcm-server-key
FCM_SENDER_ID=your-fcm-sender-id

# Payment Gateway
STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key
PAYSTACK_CALLBACK_URL=ridedeliva://payments/callback
PAYSTACK_FALLBACK_EMAIL_DOMAIN=customers.ridedeliva.app
# PAYSTACK_MOMO_PSB_BANK_CODE=   # optional; looked up from Paystack's bank list by default

# MTN MoMo Open API - Collections (MoMo PSB). Defaults target the sandbox (currency EUR).
# For production, take the base URL and target environment from momodeveloper.mtn.com.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_COLLECTION_SUBSCRIPTION_KEY=your-momo-collection-subscription-key
MOMO_API_USER=your-momo-api-user-uuid
MOMO_API_KEY=your-momo-api-key
MOMO_CALLBACK_SECRET=generate-a-long-random-string
# MOMO_CALLBACK_IPS=   # optional comma-separated MoMo callback source IPs (ask MoMo PSB for the ranges)
# MOMO_CURRENCY=NGN

# Public HTTPS URL of this API (provider callbacks/webhooks are built from it)
PUBLIC_API_URL=https://api.example.com
# PAYOUT_CRON=0 6 * * 1

# File Storage
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ride-deliva-storage

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# Session
SESSION_SECRET=your-session-secret-key
SESSION_MAX_AGE=86400000

# Monitoring
SENTRY_DSN=your-sentry-dsn

# Features Flags
ENABLE_RIDE_SHARING=true
ENABLE_DELIVERY=true
ENABLE_ANALYTICS=true
ENABLE_ADMIN_PANEL=true
